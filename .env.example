# Resend Configuration (Recommended for Email Waitlist)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Optional: Specific Audience ID (if you have multiple audiences), otherwise leaves it in default
RESEND_AUDIENCE_ID=
# Optional: Verified sender email to send automatic instant welcome confirmations (e.g. OnRead <judge@onread.app>)
RESEND_FROM_EMAIL=

# Supabase Configuration (Optional)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
